VITE_KAKAO_JS_KEY=your_kakao_javascript_key_here

# Used by api/*.js (server-side only, not exposed to the client).
# On Vercel these are injected automatically by the connected Upstash/KV
# integration — you shouldn't need to set them here except for local dev,
# where you can pull real values with `vercel env pull .env.development.local`
# or copy them from Vercel dashboard -> Project -> Settings -> Environment Variables.
KV_REST_API_URL=
KV_REST_API_TOKEN=
